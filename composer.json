{
  "authors": [
    {
      "email": "tomaschochola@tomaschochola.cz",
      "homepage": "https://github.com/tomaschochola",
      "name": "Tomáš Chochola",
      "role": "Author"
    }
  ],
  "autoload": {
    "psr-4": {
      "TomasChochola\\Psr\\Http\\RequestHandlers\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": false,
    "platform-check": true,
    "policy": {
      "abandoned": {
        "audit": "fail",
        "block": true
      },
      "advisories": {
        "audit": "fail",
        "block": true
      },
      "malware": {
        "audit": "fail",
        "block": true
      }
    },
    "sort-packages": true
  },
  "description": "PSR-15 middleware and request-handler primitives for routing, JSON responses, input processing, and error handling.",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/tomaschochola"
    }
  ],
  "homepage": "https://github.com/tomaschochola/php-psr-15-request-handlers",
  "keywords": [
    "tomaschochola",
    "TomasChochola",
    "Tomas Chochola",
    "Tomáš Chochola",
    "http",
    "middleware",
    "psr-15",
    "request-handler"
  ],
  "license": "CC-BY-ND-4.0",
  "name": "tomaschochola/php-psr-15-request-handlers",
  "prefer-stable": true,
  "provide": {
    "psr/http-server-handler-implementation": "1.0",
    "psr/http-server-middleware-implementation": "1.0"
  },
  "repositories": [
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/tooling-php-cs-fixer.git"
    },
    {
      "no-api": true,
      "type": "vcs",
      "url": "https://github.com/tomaschochola/tooling-phpstan.git"
    }
  ],
  "require": {
    "ext-json": "*",
    "ext-mbstring": "*",
    "php": "^8.5.0",
    "psr/container": "^2.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/http-server-middleware": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "ext-intl": "*",
    "ext-pcntl": "*",
    "ext-xdebug": "*",
    "ext-zip": "*",
    "phpunit/phpunit": "^13.0",
    "roave/security-advisories": "dev-latest",
    "tomaschochola/tooling-php-cs-fixer": "^2.0@dev",
    "tomaschochola/tooling-phpstan": "^2.0@dev"
  },
  "support": {
    "email": "tomaschochola@tomaschochola.cz",
    "issues": "https://github.com/tomaschochola/php-psr-15-request-handlers/issues",
    "source": "https://github.com/tomaschochola/php-psr-15-request-handlers.git"
  },
  "type": "library"
}
